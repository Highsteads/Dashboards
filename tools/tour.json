          "say": "The pills say who is home, how many radiators are calling for heat, and whether anything needs a look.",
          "do": [
            [
              "point",
              {
                "sel": "#attention-chip"
              },
              {
                "ms": 900
              }
            ]
          ]
        },
        {
          "say": "Favourites are one-tap tiles. Press the garage door,",
          "do": [
            [
              "scroll",
              {
                "sel": "button.fav-tile",
                "has": "Garage"
              },
              150
            ],
            [
              "press",
              {
                "sel": "button.fav-tile",
                "has": "Garage"
              }
            ],
            [
              "zoom",
              {
                "sel": "button.fav-tile",
                "has": "Garage"
              },
              1.5
            ]
          ]
        },
        {
          "say": "and the tile turns blue and counts the seconds while the door moves.",
          "hold": 6
