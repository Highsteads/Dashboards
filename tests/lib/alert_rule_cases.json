{
  "_about": "Shared alert-rule cases (3.47.0). tests/test_alert_rules_engine.py runs every case through the plugin's Python port (alerts_mixin.py) and tests/test_alerts_shared.mjs through the page's own judgeDevice / judgeVariable / deviceNow / ruleKey / claim in dashboards-alerts.js. Both must give the expected answer, so the two cannot drift. Device readings are raw devices (onState, displayStateValUi) as Indigo and its REST API carry them; null for 'was' means no earlier reading. Cooldown times are milliseconds.",
  "deviceNow": [
    {"dev": {"onState": 1, "displayStateValUi": null}, "expect": {"on": true, "ui": ""}},
    {"dev": {"onState": "", "displayStateValUi": 0}, "expect": {"on": false, "ui": "0"}},
    {"dev": {}, "expect": {"on": false, "ui": ""}},
    {"dev": {"onState": true, "displayStateValUi": 21.0}, "expect": {"on": true, "ui": "21"}},
    {"dev": {"onState": false, "displayStateValUi": 21.5}, "expect": {"on": false, "ui": "21.5"}},
    {"dev": {"onState": null, "displayStateValUi": true}, "expect": {"on": false, "ui": "true"}},
    {"dev": {"onState": 0, "displayStateValUi": "open"}, "expect": {"on": false, "ui": "open"}}
  ],
  "device": [
    {"why": "turns on: off to on fires", "rule": {"kind": "device", "id": 1, "name": "Lamp", "cond": "on"},
     "was": {"onState": false, "displayStateValUi": "off"}, "now": {"onState": true, "displayStateValUi": "on"}, "expect": "Lamp turned on"},
    {"why": "turns on: on to on is quiet", "rule": {"kind": "device", "id": 1, "name": "Lamp", "cond": "on"},
     "was": {"onState": true, "displayStateValUi": "on"}, "now": {"onState": true, "displayStateValUi": "on"}, "expect": null},
    {"why": "turns on: on to off is quiet", "rule": {"kind": "device", "id": 1, "name": "Lamp", "cond": "on"},
     "was": {"onState": true, "displayStateValUi": "on"}, "now": {"onState": false, "displayStateValUi": "off"}, "expect": null},
    {"why": "turns off: on to off fires", "rule": {"kind": "device", "id": 1, "name": "Lamp", "cond": "off"},
     "was": {"onState": true, "displayStateValUi": "on"}, "now": {"onState": false, "displayStateValUi": "off"}, "expect": "Lamp turned off"},
    {"why": "turns off: off to off is quiet", "rule": {"kind": "device", "id": 1, "name": "Lamp", "cond": "off"},
     "was": {"onState": false, "displayStateValUi": "off"}, "now": {"onState": false, "displayStateValUi": "off"}, "expect": null},
    {"why": "changes: a new display value fires", "rule": {"kind": "device", "id": 1, "name": "Lamp", "cond": "change"},
     "was": {"onState": true, "displayStateValUi": "40%"}, "now": {"onState": true, "displayStateValUi": "60%"}, "expect": "Lamp: 60%"},
    {"why": "changes: on with no display value reads ON", "rule": {"kind": "device", "id": 2, "name": "Fan", "cond": "change"},
     "was": {"onState": false, "displayStateValUi": ""}, "now": {"onState": true, "displayStateValUi": ""}, "expect": "Fan: ON"},
    {"why": "changes: off with a null display value reads OFF", "rule": {"kind": "device", "id": 2, "name": "Fan", "cond": "change"},
     "was": {"onState": true, "displayStateValUi": null}, "now": {"onState": false, "displayStateValUi": null}, "expect": "Fan: OFF"},
    {"why": "changes: the display value alone, while off", "rule": {"kind": "device", "id": 3, "name": "Heater", "cond": "change"},
     "was": {"onState": false, "displayStateValUi": "idle"}, "now": {"onState": false, "displayStateValUi": "standby"}, "expect": "Heater: standby"},
    {"why": "changes: nothing moved is quiet", "rule": {"kind": "device", "id": 3, "name": "Heater", "cond": "change"},
     "was": {"onState": false, "displayStateValUi": "idle"}, "now": {"onState": false, "displayStateValUi": "idle"}, "expect": null},
    {"why": "no earlier reading is never a change", "rule": {"kind": "device", "id": 1, "name": "Lamp", "cond": "on"},
     "was": null, "now": {"onState": true, "displayStateValUi": "on"}, "expect": null},
    {"why": "a number onState counts as on", "rule": {"kind": "device", "id": 4, "name": "Pump", "cond": "on"},
     "was": {"onState": 0, "displayStateValUi": "0"}, "now": {"onState": 1, "displayStateValUi": "1"}, "expect": "Pump turned on"},
    {"why": "null and false onState are the same reading", "rule": {"kind": "device", "id": 5, "name": "Sensor", "cond": "change"},
     "was": {"onState": null, "displayStateValUi": "dry"}, "now": {"onState": false, "displayStateValUi": "dry"}, "expect": null},
    {"why": "21 and 21.0 read the same", "rule": {"kind": "device", "id": 6, "name": "Thermo", "cond": "change"},
     "was": {"onState": false, "displayStateValUi": 21}, "now": {"onState": false, "displayStateValUi": 21.0}, "expect": null},
    {"why": "a number display value is written as the page writes it", "rule": {"kind": "device", "id": 6, "name": "Thermo", "cond": "change"},
     "was": {"onState": false, "displayStateValUi": 21}, "now": {"onState": false, "displayStateValUi": 21.5}, "expect": "Thermo: 21.5"},
    {"why": "a boolean display value against its text is no change", "rule": {"kind": "device", "id": 7, "name": "Door", "cond": "change"},
     "was": {"onState": true, "displayStateValUi": "true"}, "now": {"onState": true, "displayStateValUi": true}, "expect": null},
    {"why": "an unknown condition never fires", "rule": {"kind": "device", "id": 1, "name": "Lamp", "cond": "dim"},
     "was": {"onState": false, "displayStateValUi": "off"}, "now": {"onState": true, "displayStateValUi": "on"}, "expect": null},
    {"why": "a rule with no name says undefined, as the page did", "rule": {"kind": "device", "id": 1, "cond": "on"},
     "was": {"onState": false}, "now": {"onState": true}, "expect": "undefined turned on"},
    {"why": "a null name says null", "rule": {"kind": "device", "id": 1, "name": null, "cond": "off"},
     "was": {"onState": true}, "now": {"onState": false}, "expect": "null turned off"},
    {"why": "own name, turns on: the name alone", "rule": {"kind": "device", "id": 8, "name": "Someone is at the front door", "cond": "on"}, "target": "Front Door Person",
     "was": {"onState": false}, "now": {"onState": true}, "expect": "Someone is at the front door"},
    {"why": "own name, turns off: the name alone", "rule": {"kind": "device", "id": 8, "name": "The garage has been shut", "cond": "off"}, "target": "Garage Door",
     "was": {"onState": true}, "now": {"onState": false}, "expect": "The garage has been shut"},
    {"why": "the device's own name still says turned on", "rule": {"kind": "device", "id": 1, "name": "Lamp", "cond": "on"}, "target": "Lamp",
     "was": {"onState": false}, "now": {"onState": true}, "expect": "Lamp turned on"},
    {"why": "case and outer spaces do not make a name the rule's own", "rule": {"kind": "device", "id": 1, "name": "hall lamp", "cond": "off"}, "target": " Hall Lamp ",
     "was": {"onState": true}, "now": {"onState": false}, "expect": "hall lamp turned off"},
    {"why": "a device name longer than a rule keeps is still the same name", "rule": {"kind": "device", "id": 1, "name": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "cond": "on"}, "target": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
     "was": {"onState": false}, "now": {"onState": true}, "expect": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA turned on"},
    {"why": "own name, changes: the new value is still shown", "rule": {"kind": "device", "id": 8, "name": "The thermostat moved", "cond": "change"}, "target": "Hall Thermostat",
     "was": {"onState": false, "displayStateValUi": 20}, "now": {"onState": false, "displayStateValUi": 21}, "expect": "The thermostat moved: 21"},
    {"why": "an empty device name is no name to compare", "rule": {"kind": "device", "id": 1, "name": "Lamp", "cond": "on"}, "target": "",
     "was": {"onState": false}, "now": {"onState": true}, "expect": "Lamp turned on"},
    {"why": "named after its device when saved, device renamed since: still says turned off", "rule": {"kind": "device", "id": 1, "name": "Hall Lamp", "cond": "off", "own": false}, "target": "Hall Table Lamp",
     "was": {"onState": true}, "now": {"onState": false}, "expect": "Hall Lamp turned off"},
    {"why": "named after its device when saved, device renamed since: still says turned on", "rule": {"kind": "device", "id": 1, "name": "Hall Lamp", "cond": "on", "own": false}, "target": "Hall Table Lamp",
     "was": {"onState": false}, "now": {"onState": true}, "expect": "Hall Lamp turned on"},
    {"why": "own name settled when saved holds even if the device is later given the same name", "rule": {"kind": "device", "id": 8, "name": "Someone is at the front door", "cond": "on", "own": true}, "target": "Someone is at the front door",
     "was": {"onState": false}, "now": {"onState": true}, "expect": "Someone is at the front door"},
    {"why": "an own that is not true or false is ignored and the names are compared", "rule": {"kind": "device", "id": 1, "name": "Lamp", "cond": "on", "own": "yes"}, "target": "Lamp",
     "was": {"onState": false}, "now": {"onState": true}, "expect": "Lamp turned on"}
  ],
  "variable": [
    {"why": "a variable that changed fires", "rule": {"kind": "variable", "id": 9, "name": "Mode", "cond": "change"},
     "was": {"val": "home"}, "value": "away", "expect": "Mode is now away"},
    {"why": "a variable that did not is quiet", "rule": {"kind": "variable", "id": 9, "name": "Mode", "cond": "change"},
     "was": {"val": "home"}, "value": "home", "expect": null},
    {"why": "no earlier reading is never a change", "rule": {"kind": "variable", "id": 9, "name": "Mode", "cond": "change"},
     "was": null, "value": "away", "expect": null},
    {"why": "the number 1 is the text 1", "rule": {"kind": "variable", "id": 10, "name": "Count", "cond": "change"},
     "was": {"val": "1"}, "value": 1, "expect": null},
    {"why": "true is the text true", "rule": {"kind": "variable", "id": 11, "name": "Flag", "cond": "change"},
     "was": {"val": "true"}, "value": true, "expect": null},
    {"why": "3.0 is the text 3", "rule": {"kind": "variable", "id": 12, "name": "Level", "cond": "change"},
     "was": {"val": "3"}, "value": 3.0, "expect": null},
    {"why": "a fractional number is written in full", "rule": {"kind": "variable", "id": 12, "name": "Level", "cond": "change"},
     "was": {"val": "21"}, "value": 21.5, "expect": "Level is now 21.5"},
    {"why": "empty to empty is quiet", "rule": {"kind": "variable", "id": 13, "name": "Note", "cond": "change"},
     "was": {"val": ""}, "value": "", "expect": null},
    {"why": "a null value is the text null", "rule": {"kind": "variable", "id": 13, "name": "Note", "cond": "change"},
     "was": {"val": ""}, "value": null, "expect": "Note is now null"},
    {"why": "the condition is not consulted for a variable", "rule": {"kind": "variable", "id": 14, "name": "Mode", "cond": "on"},
     "was": {"val": "a"}, "value": "b", "expect": "Mode is now b"}
  ],
  "ruleKey": [
    {"rule": {"kind": "device", "id": 12, "cond": "on"}, "expect": "device:12:on"},
    {"rule": {"kind": "device", "id": 12, "cond": "off"}, "expect": "device:12:off"},
    {"rule": {"kind": "variable", "id": 9}, "expect": "variable:9:undefined"}
  ],
  "cooldown": [
    {"why": "30 s per rule, and two rules on one device keep their own",
     "events": [["device:1:on", 1000], ["device:1:on", 2000], ["device:1:off", 2000], ["device:1:on", 31000],
                ["device:1:on", 60999], ["device:1:on", 61000]],
     "expect": [true, false, true, true, false, true]},
    {"why": "a clock that went backwards lets it fire",
     "events": [["device:2:on", 50000], ["device:2:on", 40000], ["device:2:on", 45000]],
     "expect": [true, true, false]}
  ]
}
